TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required for /app: your owned public HTTPS origin with the served app path.
# Optional host-side loopback port published by docker-compose (TLS reverse proxy target).
# Optional override; config.yaml is used by default.
STRICT_ALERT_MODE=false
# Set these to `id -u` and `id -g` on a VPS if they are not 1000.
ANALYZER_UID=1000
ANALYZER_GID=1000
# Container paths and watchdog defaults normally need no changes.
# WATCHDOG_STALE_SECONDS=180
# WATCHDOG_STARTUP_GRACE_SECONDS=180
# Optional only when the host cannot resolve DNS. Never hardcode this in code.
# HYPERLIQUID_RESOLVED_IP=
# Optional event sources. Leave unset when the corresponding source is disabled.
# X_BEARER_TOKEN=
# GITHUB_EVENT_TOKEN=
# Optional read-only RPC bearer tokens for an operator-supplied official/provider endpoint.
# Public defaults require neither value. They never authorize signing or submission.
# SOLANA_RPC_BEARER_TOKEN=
# BASE_RPC_BEARER_TOKEN=
# Optional public Jupiter Swap V2 quote quota. Quotes are read-only; no wallet is used.
# JUPITER_API_KEY=
